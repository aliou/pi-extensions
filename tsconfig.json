{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true
  },
  "include": ["extensions/**/*.ts", "packages/**/*.ts", "tests/**/*.ts"],
  "exclude": [
    "./extensions/subagents/**/*.ts",
    "./extensions/qq/**/*.ts",
    "./extensions/tools/look-at/**/*.ts",
    "./extensions/breadcrumbs/tools/read-session/**/*.ts",
    "./extensions/chrome/**/*.ts"
  ]
}
